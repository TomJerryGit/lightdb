# ============================================================
# LightDB 项目 .gitignore
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
*.so
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/
.venv/
venv/
env/
.Python

# ---------- 测试 / 代码质量 ----------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ---------- Cython 生成物 ----------
*.c
*.html

# 例外：lightdb/cython/ 下随仓库分发的 .c 预编译源码需要保留
!lightdb/cython/*.c

# ---------- 数据库数据 / 日志 ----------
*.dat
*.wal
*.btroot
*.log
data/
data_*/
_tmpdata/
backups/
backups_b*/
lightdb-data/
*.sql.gz

# 运行时配置（保留随仓库分发的 config.json / *.example.json）
docker/config/config.json

# ---------- Studio 桌面版运行时 ----------
.lightdb_studio/
*.lightdb
*.qss.bak

# ---------- Web / 前端 ----------
web/static/dist/
node_modules/
.vite/

# ---------- 编辑器 / 操作系统 ----------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# ---------- 日志与诊断产物 ----------
_*.log
_*_test.log

# ---------- 临时脚本 / 探测产物（防止再次被误提交）----------
# 本会话曾误跟踪过 _diag_auth.py / _diag_scan.py / _smoke_db.py 等 scratch 文件；
# 这些是排查用的临时物，不属于软件本体。
_*.py
_*.json
_base*/
_wt_*/
.wt_*/
_probe*
_smoke*
_diag*
_gate*
_repro*
_sweep*
_bench_*_pairs.json
_acl_recovery/

_analysis_tmp/
docs/analysis_2026-10-19/logs/
docs/analysis_2026-10-19/tmp/
