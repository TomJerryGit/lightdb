{
  "host": "0.0.0.0",
  "port": 8888,
  "max_connections": 1000,
  "buffer_pool_size": 4096,
  "page_size": 4096,
  "data_dir": "/app/data",
  "backup_dir": "/app/backups",
  "workers": 4,
  "parallel_workers": 8,
  "slow_query_threshold": 0.5,
