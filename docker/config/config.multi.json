  "log_level": "INFO",
  "ip_whitelist_enabled": false,
  "max_conn_per_ip": 200,
  "password_deny_weak": true,
  "shm_dir": "/dev/shm",
  "txn_coordinator": "shared_memory",
  "lock_coordinator": "shared_memory"
}