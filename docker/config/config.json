{
  "_comment": "LightDB 主配置文件 - 通用生产版",
  "_version": "4.0.0",

  "host": "0.0.0.0",
  "port": 8888,
  "max_connections": 200,

  "buffer_pool_size": 4096,
  "page_size": 4096,
  "data_dir": "/app/data",
  "backup_dir": "/app/backups",

  "workers": 8,
  "parallel_workers": 8,

  "default_isolation": "READ COMMITTED",
  "autocommit": true,
  "wal_enabled": true,

  "slow_query_threshold": 0.5,
  "max_allowed_packet": 16777216,

  "log_level": "INFO",

  "ssl_enabled": false,
  "audit_level": "DDL",
  "semi_sync_enabled": false,

  "max_conn_per_ip": 100,
  "ip_whitelist_enabled": false,
  "ip_whitelist": [],

  "password_min_length": 6,
  "password_require_digit": false,
  "password_deny_weak": true
}